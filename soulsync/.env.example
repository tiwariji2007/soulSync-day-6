# SoulSync. Copy to .env.local and fill in; never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/soulsync

BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

RESEND_API_KEY=
RESEND_FROM_EMAIL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI features (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Per-user requests per minute
FAQ_RATE_LIMIT_PER_MINUTE=10
INSIGHTS_RATE_LIMIT_PER_MINUTE=5

# USD per million tokens. Local Ollama is free, so 0.
LLM_INPUT_COST_PER_MTOK=0
LLM_OUTPUT_COST_PER_MTOK=0
