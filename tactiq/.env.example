# TactiQ AI coach. Copy to .env.local; never commit real values.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Rate limit for /api/explain-blunder (per client IP)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# USD per million tokens. Local Ollama is free, so 0.
LLM_INPUT_COST_PER_MTOK=0
LLM_OUTPUT_COST_PER_MTOK=0

# Optional: where ai-usage.jsonl is written (default ./data)
# USAGE_LOG_DIR=./data
